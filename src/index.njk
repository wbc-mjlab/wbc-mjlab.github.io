---
layout: base.njk
permalink: /
---

<main class="page">
  <header class="hero">
    <h1>{{ site.title }}</h1>
    <p class="subtitle">{{ site.subtitle }}</p>

    <p class="authors">
      {% for author in site.authors %}
      <span>{{ author.name }}<sup>{% for a in author.affiliations %}{{ a }}{% if not loop.last %},{% endif %}{% endfor %}</sup></span>{% if not loop.last %}&ensp;{% endif %}
      {% endfor %}
    </p>
    <p class="affils">
      {% for aff in site.affiliations %}
      <span><sup>{{ loop.index }}</sup>{{ aff }}</span>{% if not loop.last %}&ensp;{% endif %}
      {% endfor %}
    </p>

    <p class="links">
      {% for link in site.links %}
      <a href="{{ link.url }}">[{{ link.label }}]</a>
      {% endfor %}
    </p>
  </header>

  <figure class="teaser">
    <div class="teaser__frame">
      <video
        data-teaser
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="{{ ('/' + site.teaser.poster) | url }}"
      >
        <source src="{{ ('/' + site.teaser.video) | url }}" type="video/mp4" />
      </video>
    </div>
    <figcaption>{{ site.teaser.caption }}</figcaption>
  </figure>

  <section>
    <h2>Abstract</h2>
    <p>{{ site.abstract }}</p>
  </section>

  <section>
    <h2>Interactive demo</h2>
    <p class="muted">
      A real MuJoCo sim and ONNX whole-body policy run live in your browser
      (WASM — no install). The robot tracks a reference motion clip;
      (<a href="{{ site.demoUrl }}">open fullscreen</a> for the full UI, including generator mode).
    </p>
    <details class="demo__controls" open>
      <summary id="demo-controls-title">Controls</summary>
      <ul class="demo__controls-list">
        <li>
          <span class="demo__btns" aria-hidden="true">
            <span class="demo__btn" title="Trajectory">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </span>
          </span>
          <span>pick a clip from the dropdown (top right).</span>
        </li>
        <li>
          <span class="demo__btns" aria-hidden="true">
            <span class="demo__btn" title="Play">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="6 3 20 12 6 21 6 3"/></svg>
            </span>
            <span class="demo__btn" title="Pause">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="14" y="4" width="4" height="16" rx="1"/><rect x="6" y="4" width="4" height="16" rx="1"/></svg>
            </span>
            <span class="demo__btn" title="Loop">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
            </span>
          </span>
          <span>play, pause, loop clip (not policy).</span>
        </li>
        <li>
          <span class="demo__btns" aria-hidden="true">
            <span class="demo__btn" title="Get up">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
            </span>
            <span class="demo__btn" title="Lie down">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
            </span>
          </span>
          <span>get up when down, lie down when idle.</span>
        </li>
        <li>
          <span class="demo__btns" aria-hidden="true">
            <span class="demo__btn" title="Mouse">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="3" width="12" height="18" rx="6"/><path d="M12 7v4"/></svg>
            </span>
          </span>
          <span>click-drag the robot to push/pull; empty space orbits the camera.</span>
        </li>
        <li>
          <span class="demo__btns" aria-hidden="true">
            <span class="demo__btn demo__btn--key" title="R">R</span>
          </span>
          <span>reset pose.</span>
        </li>
      </ul>
    </details>
    <div class="demo is-loaded" data-demo>
      <iframe
        class="demo__frame"
        title="wbc-demo"
        src="{{ site.demoEmbedUrl }}"
        data-demo-src="{{ site.demoEmbedUrl }}"
        loading="eager"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </section>

  <section>
    <h2>Try it fast</h2>
    <p>{{ site.quickstart.intro }}</p>
    <ol class="qs">
      {% for step in site.quickstart.steps %}
      <li>
        <p class="qs__title"><strong>{{ step.title }}.</strong>
          {% if step.text %}{{ step.text }}{% endif %}
          {% if step.href %}
          <a href="{{ step.href }}">{{ step.hrefLabel }}</a>
          {% endif %}
        </p>
        {% if step.code %}
        <pre class="listing"><code>{{ step.code }}</code></pre>
        {% endif %}
      </li>
      {% endfor %}
    </ol>
    <p class="muted">{{ site.quickstart.note }}
      See also the
      <a href="https://wbc-mjlab.github.io/wbc-mjlab/source/installation.html">installation guide</a>.
    </p>
  </section>

  <section>
    <h2>Particularities</h2>
    {% for item in site.notes %}
    <div class="tech-note">
      <p class="para">
        <strong>{{ item.title }}.</strong>
        {{ item.text | safe }}
      </p>
      {% if item.eq %}
      <p class="eq">\[ {{ item.eq | safe }} \]</p>
      {% endif %}
    </div>
    {% endfor %}
  </section>

  <section>
    <h2>Code</h2>
    <ul class="repos">
      {% for repo in site.repos %}
      <li>
        <a href="{{ repo.url }}"><code>{{ repo.name }}</code></a>
        — {{ repo.blurb }}
      </li>
      {% endfor %}
    </ul>
  </section>

  <section>
    <h2>Related</h2>
    <p class="related">
      {% for ref in site.related %}
      <a href="{{ ref.url }}">{{ ref.title }}</a>{% if ref.extra %}
      (<a href="{{ ref.extra }}">{{ ref.extraLabel }}</a>){% endif %}{% if not loop.last %} · {% endif %}
      {% endfor %}
    </p>
  </section>

  <section>
    <div class="bib-head">
      <h2>BibTeX</h2>
      <button class="copy" type="button" data-copy-bib>Copy</button>
    </div>
    <pre><code data-bib>{{ site.citation }}</code></pre>
  </section>

  <footer>
    <a href="{{ site.org }}">github.com/wbc-mjlab</a>
    · {{ site.year }}
  </footer>
</main>
