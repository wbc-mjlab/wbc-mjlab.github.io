<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ site.title }} — {{ site.subtitle }}</title>
  <meta name="description" content="{{ site.abstract | truncate(160) }}" />
  <meta property="og:title" content="{{ site.title }}: {{ site.subtitle }}" />
  <meta property="og:description" content="{{ site.abstract | truncate(160) }}" />
  <meta property="og:image" content="{{ '/assets/collage.jpg' | url }}" />
  {# Computer Modern — lmodern-style paper fonts #}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/dreampulse/computer-modern-web-font@master/font/Serif/cmun-serif.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/dreampulse/computer-modern-web-font@master/font/Typewriter/cmun-typewriter.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css" crossorigin="anonymous" />
  <link rel="stylesheet" href="{{ '/css/site.css' | url }}" />
</head>
<body>
  {{ content | safe }}
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.js" crossorigin="anonymous"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/contrib/auto-render.min.js" crossorigin="anonymous"></script>
  <script src="{{ '/js/site.js' | url }}" defer></script>
</body>
</html>
